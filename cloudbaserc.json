{
  "envId": "cloud1-d3gaw888m9a89e2ff",
  "functionRoot": "./cloudfunctions/.deploy",
  "functions": [
    {
      "name": "study-v2",
      "type": "Event",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 30,
      "memorySize": 256,
      "installDependency": true,
      "ignore": [
        "node_modules",
        ".git",
        ".env",
        ".env.*",
        ".data"
      ]
    },
    {
      "name": "daily-content",
      "type": "Event",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 120,
      "memorySize": 256,
      "installDependency": true,
      "envVariables": {
        "DAILY_AI_MODEL": "hy4",
        "DAILY_TTS_VOICE_TYPE": "101050"
      },
      "triggers": [
        {
          "name": "generate-next-day-at-3am",
          "type": "timer",
          "config": "0 0 3 * * * *"
        }
      ],
      "ignore": [
        "node_modules",
        ".git",
        ".env",
        ".env.*",
        ".data"
      ]
    }
  ]
}

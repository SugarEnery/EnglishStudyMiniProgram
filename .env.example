# 后端环境变量；填写真实值前微信登录明确不可用
WX_APP_ID=wx9f10baeaa159ae5e
WX_APP_SECRET=
# 后端端口；开发工具需在本地设置中关闭域名校验连接loopback
PORT=8788
# 编译时使用，正式环境必须HTTPS；不要将AppSecret放在MINIAPP变量中
MINIAPP_API_BASE=http://127.0.0.1:8788

# 小程序公开构建配置：Taro构建须显式传入命令环境变量，不自动加载此文件。
# 云存储根格式为 cloud://环境ID.桶名，不带/audio或末尾斜线。
MINIAPP_BACKEND=cloud
MINIAPP_CLOUD_ENV_ID=
MINIAPP_CLOUD_STORAGE_ROOT=
